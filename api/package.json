{
  "name": "conta-api",
  "version": "0.1.0",
  "description": "API única de CONTA (NestJS). Todas las reglas fiscales, contables, multiempresa y de pagos.",
  "private": true,
  "license": "UNLICENSED",
  "type": "module",
  "engines": {
    "node": ">=22.12 <23",
    "npm": ">=10.9"
  },
  "scripts": {
    "build": "nest build",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:prod": "NODE_ENV=production node dist/main.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "vitest run --config ./vitest.config.e2e.ts",
    "migrar": "node scripts/migrar.mjs",
    "migracion:nueva": "drizzle-kit generate --custom --name",
    "contrato": "node scripts/generar-contrato.mjs",
    "tipos": "tsc --noEmit -p tsconfig.json",
    "dependencias": "depcruise src --config .dependency-cruiser.cjs --output-type err-long",
    "lint": "eslint ."
  },
  "dependencies": {
    "@nestjs/common": "12.6.0",
    "@nestjs/core": "12.6.0",
    "@nestjs/platform-express": "12.6.0",
    "@nestjs/swagger": "12.1.2",
    "@xmldom/xmldom": "0.8.15",
    "drizzle-orm": "0.45.4",
    "node-forge": "1.4.3",
    "pg": "8.23.1",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "xml-crypto": "6.4.0"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.17",
    "@eslint/js": "9.39.5",
    "@nestjs/cli": "12.0.15",
    "@nestjs/schematics": "12.0.16",
    "@nestjs/testing": "12.6.0",
    "@types/express": "5.0.6",
    "@types/node": "22.20.5",
    "@types/node-forge": "1.3.14",
    "@types/pg": "8.23.1",
    "@types/supertest": "7.2.1",
    "dependency-cruiser": "18.9.0",
    "drizzle-kit": "0.31.11",
    "eslint": "9.39.5",
    "fast-check": "4.10.2",
    "globals": "16.4.0",
    "supertest": "7.3.2",
    "typescript": "6.0.3",
    "typescript-eslint": "8.73.0",
    "vite": "8.3.8",
    "vitest": "5.1.1",
    "xmllint-wasm": "5.3.0",
    "yaml": "2.9.1"
  }
}
